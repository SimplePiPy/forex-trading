# Copy to .env and `export $(cat .env | xargs)` or use your host's secret manager.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_NUMBER=+18885551234          # toll-free recommended for a fast launch (see README)
TWILIO_VALIDATE=true

PUBLIC_URL=https://your-app.up.railway.app
OWNER_CELL=+17045551234             # where calls ring and alerts go
RING_SECONDS=20
SUMMARY_HOUR=19

BUSINESS_PROFILE=./profiles/monkeys-tree-service.json
DB_PATH=./data/groundie.db
TZ_NAME=America/New_York
